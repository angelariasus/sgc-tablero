# URL pública de la API (Render). En local: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Inicio de sesión: "supabase" (producción) o "dev" (solo desarrollo local, sin Supabase)
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable) del proyecto. No es secreta; las tablas no se pueden leer con ella (RLS activado).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
