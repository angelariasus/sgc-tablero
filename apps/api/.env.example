# ===== API (Render) =====
NODE_ENV=production
PORT=8080

# Cadena de conexión de Supabase: Project Settings > Database > Connection string > "Session pooler" (acepta IPv4).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Auth / Storage
SUPABASE_URL=https://PROYECTO.supabase.co
# Clave "service_role" (SECRETA: solo en Render, nunca en Vercel ni en el navegador). Sirve para crear cuentas y guardar los Excel.
SUPABASE_SERVICE_ROLE_KEY=
# Solo si tu proyecto usa la clave JWT heredada (HS256). Con claves de firma asimétricas déjalo vacío.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=sgc-archivos

# Dominio(s) del frontend en Vercel, separados por coma (sin barra final)
CORS_ORIGINS=https://tu-tablero.vercel.app

# Correo de la PRIMERA cuenta administradora (créala antes en Supabase > Authentication > Users). Se vuelve admin al entrar por primera vez.
BOOTSTRAP_ADMIN_EMAIL=admin@unmsm.edu.pe

MAX_UPLOAD_MB=15
LOG_LEVEL=info
